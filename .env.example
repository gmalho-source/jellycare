# Origem pública do dashboard. Obrigatória em produção: sem ela as ligações de
# entrada são construídas a partir do cabeçalho `host`, que um pedido pode forjar.
JELLYCARE_APP_URL=http://localhost:3000

# Base de dados
DATABASE_URL=postgres://jellycare:jellycare@localhost:5432/jellycare

# Filas
REDIS_URL=redis://localhost:6379

# Região desta instância de worker. O uptime exige confirmação a partir de uma
# segunda região antes de declarar downtime.
JELLYCARE_REGION=eu-west

# Afinação do worker (opcionais). Os valores são os de omissão. As duas últimas
# importam com um Redis pago ao comando; ver docs/deploy.md, secção Upstash.
JELLYCARE_CONCURRENCY=5
JELLYCARE_SCHEDULER_INTERVAL_MS=30000
JELLYCARE_DRAIN_DELAY_SECONDS=
JELLYCARE_STALLED_INTERVAL_MS=

# Inbox canária: domínio separado do domínio principal, com reputação própria.
# Sem isto, a rotina de teste de formulários não corre.
CANARY_EMAIL_DOMAIN=check.jellycare.pt
CANARY_INBOX_WEBHOOK_SECRET=

# Chromium para a submissão de formulários. Em imagens que já o trazem
# instalado, aponte para o binário e evite a descarga.
JELLYCARE_CHROMIUM_PATH=
JELLYCARE_CHROMIUM_NO_SANDBOX=

# Reputação: URLhaus (abuse.ch). Sem a chave, o check de reputação fica sem
# fonte e di-lo no resultado. A Google Safe Browsing foi retirada de propósito
# (licença não comercial); ver packages/checks/src/reputation.ts.
URLHAUS_AUTH_KEY=

# Velocidade das páginas: Google PageSpeed Insights. Sem a chave, o check falha
# com a razão à vista.
GOOGLE_PAGESPEED_API_KEY=

# WP Umbrella: inventário WordPress, atualizações e cópias de segurança. Nas
# duas apps — o worker sincroniza, o dashboard lista os projetos para ligar.
WP_UMBRELLA_TOKEN=

# Notificações
RESEND_API_KEY=
ALERT_FROM_EMAIL=alertas@jellycare.pt

# Relatórios mensais. O remetente é separado do dos alertas: um relatório não
# interrompe ninguém e não deve partilhar reputação com o canal de incidentes.
REPORT_FROM_EMAIL=relatorios@jellycare.pt

# Assistente técnico interno. Sem isto o botão «Pedir apoio» responde 503 com a
# razão à vista. Ver docs/assistente.md.
ANTHROPIC_API_KEY=

# Remetente dos avisos ao cliente. Tem de ser de um domínio verificado no Resend.
NOTICE_FROM_EMAIL=
